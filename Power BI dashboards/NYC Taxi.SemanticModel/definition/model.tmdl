model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["fact_trips","dim_date","dim_location","dim_payment_type"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_trips
ref table dim_date
ref table dim_location
ref table dim_payment_type

ref cultureInfo en-US

