	column 'trip_duration_minutes (bins)' =
			IF(
				ISBLANK('fact_trips'[trip_duration_minutes]),
				BLANK(),
				IF(
					'fact_trips'[trip_duration_minutes] >= 0,
					ROUNDDOWN('fact_trips'[trip_duration_minutes] / 5, 0) * 5,
					ROUNDUP('fact_trips'[trip_duration_minutes] / 5, 0) * 5
				)
			)
